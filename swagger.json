                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Books"
        ],
        "summary": "Update an existing book (partial updates allowed) (requires login)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookUpdate"
              },
              "example": {
                "rating": 4.9,
                "inStock": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Book updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Book"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error, invalid ID, or referenced author does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Book not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Books"
        ],
        "summary": "Delete a book (requires login)",
        "responses": {
          "200": {
            "description": "Book deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Book"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Book not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health check (includes database connection state)",
        "responses": {
          "200": {
            "description": "API is up and the database is connected",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "database": {
                      "type": "string",
                      "example": "connected"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "API is up but the database is not connected",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "status": {
                      "type": "string",
                      "example": "degraded"
                    },
                    "database": {
                      "type": "string",
                      "example": "disconnected"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log in with GitHub (OAuth)",
        "description": "Open this URL in the browser (not via 'Try it out'). Redirects to GitHub, then back to /api-docs. Creates a user record on first login.",
        "responses": {
          "302": {
            "description": "Redirect to GitHub authorization page"
          }
        }
      }
    },
    "/auth/github/callback": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "GitHub OAuth callback",
        "description": "Called by GitHub after authorization. Not meant to be called manually.",
        "responses": {
          "302": {
            "description": "Redirects to /api-docs on success"
          },
          "401": {
            "description": "GitHub login failed"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Check current login status",
        "description": "Returns whether the current session is logged in.",
        "responses": {
          "200": {
            "description": "Login status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "loggedIn": {
                      "type": "boolean"
                    },
                    "user": {
                      "type": "object",
                      "properties": {
                        "githubId": {
                          "type": "string"
                        },
                        "username": {
                          "type": "string"
                        },
                        "displayName": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/logout": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log out",
        "description": "Destroys the session.",
        "responses": {
          "200": {
            "description": "Logged out",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Logged out"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Author": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "66f0c2a1e4b0a1a2b3c4d5e6"
          },
          "name": {
            "type": "string",
            "example": "George Orwell"
          },
          "bio": {
            "type": "string",
            "example": "English novelist and essayist."
          },
          "birthYear": {
            "type": "integer",
            "example": 1903
          },
          "nationality": {
            "type": "string",
            "example": "British"
          },
          "website": {
            "type": "string",
            "example": "https://www.orwellfoundation.com"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuthorInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Author's full name (required)"
          },
          "bio": {
            "type": "string",
            "description": "Short biography"
          },
          "birthYear": {
            "type": "integer",
            "description": "1000 - current year"
          },
          "nationality": {
            "type": "string"
          },
          "website": {
            "type": "string",
            "description": "Must be a valid URL if provided"
          }
        }
      },
      "Book": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "66f0c3b2e4b0a1a2b3c4d5e7"
          },
          "title": {
            "type": "string",
            "example": "1984"
          },
          "author": {
            "$ref": "#/components/schemas/Author"
          },
          "isbn": {
            "type": "string",
            "example": "978-0-452-28423-4"
          },
          "genre": {
            "type": "string",
            "example": "Dystopian Fiction"
          },
          "publishedYear": {
            "type": "integer",
            "example": 1949
          },
          "pages": {
            "type": "integer",
            "example": 328
          },
          "rating": {
            "type": "number",
            "example": 4.8
          },
          "description": {
            "type": "string"
          },
          "inStock": {
            "type": "boolean",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BookInput": {
        "type": "object",
        "required": [
          "title",
          "author",
          "isbn",
          "genre",
          "publishedYear",
          "pages"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string",
            "description": "Must reference an existing Author's _id",
            "example": "PASTE_AUTHOR_ID_FROM_POST_/api/authors"
          },
          "isbn": {
            "type": "string",
            "description": "Must be unique"
          },
          "genre": {
            "type": "string"
          },
          "publishedYear": {
            "type": "integer",
            "description": "1000 - current year"
          },
          "pages": {
            "type": "integer",
            "description": "Must be >= 1"
          },
          "rating": {
            "type": "number",
            "description": "0 - 5, defaults to 0"
          },
          "description": {
            "type": "string"
          },
          "inStock": {
            "type": "boolean",
            "description": "Defaults to true"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Descriptive error message"
          }
        }
      },
      "AuthorUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Author's full name (required)"
          },
          "bio": {
            "type": "string",
            "description": "Short biography"
          },
          "birthYear": {
            "type": "integer",
            "description": "1000 - current year"
          },
          "nationality": {
            "type": "string"
          },
          "website": {
            "type": "string",
            "description": "Must be a valid URL if provided"
          }
        },
        "description": "Any subset of fields may be sent."
      },
      "BookUpdate": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string",
            "description": "Must reference an existing Author's _id"
          },
          "isbn": {
            "type": "string",

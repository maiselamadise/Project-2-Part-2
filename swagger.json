{
  "openapi": "3.0.3",
  "info": {
    "title": "Library API",
    "description": "A REST API for managing a library's books and authors, built with Node.js, Express, and MongoDB (Mongoose).\n\n**How to test:** click an endpoint, press *Try it out*, then *Execute*. Requests go to the host serving this page.\n1. `POST /api/authors` - create an author and copy the `_id` from the response.\n2. `POST /api/books` - paste that `_id` into the `author` field and create a book (ISBN must be unique).\n3. `GET /api/books` - confirm the author is populated.\n4. `PUT /api/books/{id}` - update it (partial bodies are fine).\n5. `DELETE /api/books/{id}` - remove it.\n\n**Authentication:** GET routes are public. POST, PUT and DELETE require GitHub OAuth login. Open `/login` in the same browser first (Swagger UI cannot run the OAuth redirect itself); the session cookie is then sent automatically with *Try it out* requests. Use `/logout` to end the session.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "This server (the same host that is serving this page)"
    }
  ],
  "tags": [
    {
      "name": "Authors",
      "description": "Operations on the /api/authors collection"
    },
    {
      "name": "Books",
      "description": "Operations on the /api/books collection"
    },
    {
      "name": "System",
      "description": "Service status"
    },
    {
      "name": "Authentication",
      "description": "GitHub OAuth login/logout"
    }
  ],
  "paths": {
    "/api/authors": {
      "get": {
        "tags": [
          "Authors"
        ],
        "summary": "Get all authors",
        "responses": {
          "200": {
            "description": "List of authors",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "count": {
                      "type": "integer",
                      "example": 2
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Author"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Authors"
        ],
        "summary": "Create a new author (requires login)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorInput"
              },
              "example": {
                "name": "George Orwell",
                "bio": "English novelist and essayist.",
                "birthYear": 1903,
                "nationality": "British",
                "website": "https://www.orwellfoundation.com"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Author created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Author"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    },
